<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PageBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E4E7"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D4D4D8"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#71717A"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A1A1AA"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#B5631A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#965012"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FBEEE2"/>
    <!-- Текст на AccentBrush/AccentHoverBrush: тут акцент тёмный, поэтому почти белый. -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFF8EC"/>

    <!-- Цвета строк журнала (лога) — по смыслу, не по теме. -->
    <SolidColorBrush x:Key="LogErrorBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="LogWarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#16A34A"/>

</ResourceDictionary>
