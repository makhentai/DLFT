<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PageBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="CardBrush" Color="#27272A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#52525B"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#E08A34"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F2A659"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A2A18"/>
    <!-- Текст на AccentBrush/AccentHoverBrush: тут акцент светлый, белый на нём почти не виден. -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1A1206"/>

    <!-- Цвета строк журнала (лога) — по смыслу, не по теме. -->
    <SolidColorBrush x:Key="LogErrorBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="LogWarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#4ADE80"/>

</ResourceDictionary>
